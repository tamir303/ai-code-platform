# =============================================================================
# AI Code Platform — Test Environment Configuration (.env.test)
# =============================================================================
APP_ENV=test
PROJECT_NAME="On-Prem AI Code Platform (Test)"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8080

# ---- Test PostgreSQL Database ----
POSTGRES_USER=postgres_test
POSTGRES_PASSWORD=postgres_test_secret
POSTGRES_HOST=postgres-test
POSTGRES_PORT=5432
POSTGRES_DB=code_assistant_test_db
DATABASE_URL=postgresql+asyncpg://postgres_test:postgres_test_secret@postgres-test:5432/code_assistant_test_db

# ---- Test Redis ----
REDIS_HOST=redis-test
REDIS_PORT=6379
REDIS_URL=redis://redis-test:6379/0

# ---- LiteLLM Test Settings ----
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-test-master-key
DEFAULT_CODE_MODEL=qwen-coder
SYSTEM_PROMPT=You are an expert AI software architect and coding assistant.

# =============================================================================
# AI Code Platform — Environment Configuration
# Copy this file to .env.dev or .env.prod and fill in real values.
#   cp .env.example .env.dev
# =============================================================================

# Environment (dev | prod)
APP_ENV=dev

# ---- Domain & Gateway Configuration ----
NGINX_HOST=localhost        # Production domain or IP (e.g. ai-code.internal.domain)

# ---- PostgreSQL Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=code_assistant_db

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- LiteLLM Proxy ----
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-change-me-generate-a-secure-key
DEFAULT_CODE_MODEL=qwen-coder

# ---- Hugging Face ----
HF_TOKEN=hf_your_huggingface_token_here
# HF_ENDPOINT=              # Optional — custom HF mirror endpoint (prod only)

# ---- NVIDIA GPU Configuration ----
GPU_COUNT=all               # Number of GPUs to allocate (e.g. 1, 2, all)
NVIDIA_VISIBLE_DEVICES=all  # Specific GPU IDs (e.g. 0, 0,1, all)

# ---- vLLM Engine Settings ----
VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
VLLM_GPU_MEM_UTIL=0.88     # GPU memory utilization (0.0–1.0) — use ~0.92 in prod
VLLM_MAX_MODEL_LEN=8192    # Max context window — use 16384+ in prod if VRAM allows

# ---- Grafana Observability ----
GRAFANA_ADMIN_PASSWORD=admin # Admin password for Grafana UI
